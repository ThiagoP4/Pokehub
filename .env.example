# Porta da API/Servidor do PokeHub (ex: jail aplicacoes 10.15.91.50)
PORT=3001

# Fonte de dados: 'filesystem' (lê arquivos da pasta world do Cobblemon) ou 'database' (PostgreSQL/MongoDB)
DATA_PROVIDER=filesystem

# Caminho onde está o servidor de Minecraft (ex: montado via nullfs na jail aplicacoes ou rodando na jail minecraft)
# Se omitido, usa automaticamente server/sample-world
MINECRAFT_SERVER_PATH=/usr/local/bastille/jails/minecraft/root/servidor
MINECRAFT_WORLD_NAME=world

# Reservado para futura conexão com a jail database (10.15.89.50) ou mongodb (10.15.88.50)
DATABASE_URL=postgres://usuario:senha@10.15.89.50:5432/pokehub

